{
	"name": "mitmarcus.com",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "pnpm velite --watch & next dev",
		"build": "prisma generate && pnpm velite build && pnpm generate:insta && next build",
		"generate:insta": "tsx src/scripts/generate-insta-thumbs.ts && tsx src/scripts/generate-insta-manifest.ts && tsx src/scripts/generate-insta-og.ts",
		"start": "next start",
		"lint": "biome check",
		"format": "biome format --write",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage"
	},
	"pnpm": {
		"supportedArchitectures": {
			"os": [
				"darwin",
				"current"
			],
			"cpu": [
				"x64",
				"arm64"
			]
		},
		"overrides": {
			"@types/react": "19.2.14",
			"@types/react-dom": "19.2.3"
		}
	},
	"dependencies": {
		"@fullhuman/postcss-purgecss": "^6.0.0",
		"@giscus/react": "^3.1.0",
		"@mdx-js/react": "^3.1.1",
		"@prisma/client": "^5.22.0",
		"@radix-ui/react-dropdown-menu": "^2.1.24",
		"@radix-ui/react-separator": "^1.1.15",
		"@vercel/analytics": "^1.6.1",
		"@vercel/speed-insights": "^1.3.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"framer-motion": "^11.18.2",
		"next": "16.2.11",
		"next-intl": "^4.13.4",
		"octokit": "^5.0.5",
		"react": "19.2.5",
		"react-dom": "19.2.5",
		"react-icons": "^5.7.0",
		"rehype-pretty-code": "0.14.0",
		"remark-gfm": "^4.0.1",
		"rss": "^1.2.2",
		"sharp": "^0.35.3",
		"shiki": "1.18.0",
		"swr": "2.4.1",
		"tailwindcss-animate": "^1.0.7",
		"tsx": "^4.23.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.11",
		"@tailwindcss/postcss": "^4.3.3",
		"@tailwindcss/typography": "^0.5.20",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@trivago/prettier-plugin-sort-imports": "^4.3.0",
		"@types/jest": "^30.0.0",
		"@types/node": "22.5.5",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"@types/rss": "^0.0.32",
		"jest": "^30.4.2",
		"jest-environment-jsdom": "^30.4.1",
		"postcss": "^8.5.23",
		"prettier": "^3.9.6",
		"prisma": "^5.22.0",
		"tailwind-merge": "^2.6.1",
		"tailwindcss": "^4.3.3",
		"typescript": "5.6.2",
		"velite": "0.3.1"
	}
}
